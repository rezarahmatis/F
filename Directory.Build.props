<Project>
  <PropertyGroup>
    <Product>NEREA</Product>
    <Company>NEREA</Company>
    <Copyright>NEREA</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>NEREA - Let the music create the world.</Description>
    <!-- Allows restoring/compiling the Windows-targeted libraries on CI machines of any OS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
