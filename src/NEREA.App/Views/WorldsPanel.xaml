<UserControl
    x:Class="NEREA.App.Views.WorldsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEREA.App"
    xmlns:vm="using:NEREA.App.ViewModels">

    <Border Background="{ThemeResource NereaPanelBrush}" BorderBrush="{ThemeResource NereaPanelEdgeBrush}"
            BorderThickness="1" CornerRadius="16" Padding="20,16,20,14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Worlds" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
                <Button Command="{x:Bind ViewModel.SurpriseCommand}" HorizontalAlignment="Right" Background="Transparent"
                        BorderThickness="0" ToolTipService.ToolTip="Take me somewhere else" AutomationProperties.Name="Random world">
                    <FontIcon Glyph="&#xE8B1;" FontSize="15" />
                </Button>
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="WorldList_ItemClick" AutomationProperties.Name="Worlds">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorldRow">
                        <Grid Padding="2,4" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="{x:Bind Name}" Visibility="{x:Bind local:Fn.Vis(IsHeader)}"
                                       Style="{StaticResource PanelSection}" Margin="0,10,0,0" />
                            <Ellipse Width="6" Height="6" Fill="{StaticResource NereaAccentBrush}" HorizontalAlignment="Center"
                                     Visibility="{x:Bind local:Fn.Vis(IsCurrent), Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Visibility="{x:Bind local:Fn.Vis(IsWorld)}" FontSize="15"
                                       FontFamily="{StaticResource NereaSerif}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
