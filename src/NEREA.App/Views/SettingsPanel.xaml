<UserControl
    x:Class="NEREA.App.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEREA.App">

    <Border Background="{ThemeResource NereaPanelBrush}" BorderBrush="{ThemeResource NereaPanelEdgeBrush}"
            BorderThickness="1" CornerRadius="16" Padding="20,16,8,14">
        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Settings" Style="{StaticResource PanelTitle}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel Spacing="10">

                    <TextBlock Text="AUDIO" Style="{StaticResource PanelSection}" />
                    <ComboBox Header="Output device" ItemsSource="{x:Bind ViewModel.DeviceNames, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.DeviceIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ToggleSwitch Header="Normalize volume (ReplayGain)" IsOn="{x:Bind ViewModel.Normalize, Mode=TwoWay}" />

                    <TextBlock Text="VISUAL" Style="{StaticResource PanelSection}" />
                    <ComboBox Header="Quality" ItemsSource="{x:Bind ViewModel.PerformanceNames}"
                              SelectedIndex="{x:Bind ViewModel.PerformanceIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ComboBox Header="Frame rate limit" ItemsSource="{x:Bind ViewModel.FpsNames}"
                              SelectedIndex="{x:Bind ViewModel.FpsIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ComboBox Header="Water quality" ItemsSource="{x:Bind ViewModel.WaterNames}"
                              SelectedIndex="{x:Bind ViewModel.WaterIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <Slider Header="Particles" Minimum="0" Maximum="2" StepFrequency="0.05" Value="{x:Bind ViewModel.Particles, Mode=TwoWay}" />
                    <Slider Header="Fish population" Minimum="0.25" Maximum="1.5" StepFrequency="0.05" Value="{x:Bind ViewModel.Population, Mode=TwoWay}" />
                    <ToggleSwitch Header="Reflections" IsOn="{x:Bind ViewModel.Reflections, Mode=TwoWay}" />
                    <ToggleSwitch Header="Shadows" IsOn="{x:Bind ViewModel.Shadows, Mode=TwoWay}" />

                    <TextBlock Text="INTERACTION" Style="{StaticResource PanelSection}" />
                    <Slider Header="Mouse sensitivity" Minimum="0.2" Maximum="2" StepFrequency="0.05" Value="{x:Bind ViewModel.MouseSensitivity, Mode=TwoWay}" />
                    <Slider Header="Ripple strength" Minimum="0" Maximum="2" StepFrequency="0.05" Value="{x:Bind ViewModel.RippleStrength, Mode=TwoWay}" />
                    <Slider Header="Fish reaction" Minimum="0" Maximum="2" StepFrequency="0.05" Value="{x:Bind ViewModel.FishReaction, Mode=TwoWay}" />

                    <TextBlock Text="PERFORMANCE" Style="{StaticResource PanelSection}" />
                    <ToggleSwitch Header="Reduce quality when Battery Saver is on" IsOn="{x:Bind ViewModel.BatteryOptimization, Mode=TwoWay}" />
                    <ToggleSwitch Header="Pause the ocean while minimized" IsOn="{x:Bind ViewModel.PauseWhenMinimized, Mode=TwoWay}" />

                    <TextBlock Text="APPLICATION" Style="{StaticResource PanelSection}" />
                    <ComboBox Header="Theme" ItemsSource="{x:Bind ViewModel.ThemeNames}"
                              SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <Slider Header="Interface size" Minimum="0.85" Maximum="1.5" StepFrequency="0.05" Value="{x:Bind ViewModel.UiScale, Mode=TwoWay}" />
                    <ToggleSwitch Header="Reduced motion" IsOn="{x:Bind ViewModel.ReducedMotion, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="Minimize to tray" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="Track notifications while in the tray" IsOn="{x:Bind ViewModel.Notifications, Mode=TwoWay}" />

                    <TextBlock Text="Space play / pause · N next · P previous · M mute · Ctrl+O add music · Ctrl+F search · C cinematic · A ambient · F11 full screen · Esc back"
                               TextWrapping="Wrap" FontSize="11" Opacity="0.55" Margin="0,14,0,10" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
