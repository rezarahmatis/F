<UserControl
    x:Class="NEREA.App.Views.LibraryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEREA.App"
    xmlns:vm="using:NEREA.App.ViewModels">

    <Border Background="{ThemeResource NereaPanelBrush}" BorderBrush="{ThemeResource NereaPanelEdgeBrush}"
            BorderThickness="1" CornerRadius="16" Padding="20,16,20,14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title and import -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Library" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="12" Opacity="0.6" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ImportFilesCommand}" ToolTipService.ToolTip="Add songs  (Ctrl+O)"
                            AutomationProperties.Name="Add songs" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ImportFolderCommand}" ToolTipService.ToolTip="Add a folder"
                            AutomationProperties.Name="Add a folder" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE838;" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search and sort -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Search songs, artists, albums"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.SortOptions}"
                          SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" MinWidth="130"
                          AutomationProperties.Name="Sort by" />
            </Grid>

            <!-- Views -->
            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.TabNames}" SelectedIndex="{x:Bind ViewModel.TabIndex, Mode=TwoWay}"
                      SelectionMode="Single" AutomationProperties.Name="Library views">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontSize="13" Margin="2,0" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Drill-down / play row -->
            <Grid Grid.Row="3" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{x:Bind ViewModel.BackCommand}" Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        AutomationProperties.Name="Back" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DrillTitle, Mode=OneWay}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NereaSerif}" FontSize="16" />
                <Button Grid.Column="2" Command="{x:Bind ViewModel.PlayAllCommand}" ToolTipService.ToolTip="Play all"
                        AutomationProperties.Name="Play all" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" Command="{x:Bind ViewModel.ShuffleAllCommand}" ToolTipService.ToolTip="Shuffle all"
                        AutomationProperties.Name="Shuffle all" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" Command="{x:Bind ViewModel.NewPlaylistCommand}" ToolTipService.ToolTip="New playlist"
                        Visibility="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay}"
                        AutomationProperties.Name="New playlist" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Rows -->
            <Grid Grid.Row="4">
                <ListView x:Name="RowList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="RowList_ItemClick" DoubleTapped="RowList_DoubleTapped"
                          RightTapped="RowList_RightTapped" KeyDown="RowList_KeyDown"
                          AutomationProperties.Name="Songs">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryRow">
                            <Grid Padding="4,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="14" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Detail}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Click="Star_Click" Visibility="{x:Bind local:Fn.Vis(IsTrack)}"
                                        Background="Transparent" BorderThickness="0" Padding="6" MinWidth="0" MinHeight="0"
                                        AutomationProperties.Name="Favorite">
                                    <FontIcon FontFamily="{StaticResource NereaIcons}" FontSize="13"
                                              Glyph="{x:Bind local:Fn.StarGlyph(IsFavorite), Mode=OneWay}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Opacity="0.55"
                           TextWrapping="Wrap" FontSize="13" IsHitTestVisible="False" />
            </Grid>

            <!-- Import progress -->
            <StackPanel Grid.Row="5" Spacing="4" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}">
                <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind ViewModel.ImportProgress, Mode=OneWay}" />
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.ImportStatus, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    <HyperlinkButton Content="Cancel" Command="{x:Bind ViewModel.CancelImportCommand}" HorizontalAlignment="Right"
                                     Padding="0" FontSize="12" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
